# Copy this file to .env. Uses the local Ollama model verified for this project.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434

# API providers are optional and unused for the Ollama configuration.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
